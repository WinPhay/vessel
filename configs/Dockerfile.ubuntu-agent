# Vessel AgentOS - Full Developer Ubuntu Image
# Comprehensive toolchain for Node, Python, and C/C++ compilation.
FROM ubuntu:24.04

# Prevent interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    git \
    curl \
    jq \
    ripgrep \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Enforce non-interactive execution invariants for LLM drivers
ENV TERM=dumb \
    PAGER=cat \
    GIT_PAGER=cat \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

CMD ["sh", "-c", "while true; do sleep 3600; done"]
