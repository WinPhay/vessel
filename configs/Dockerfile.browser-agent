# Vessel AgentOS - Headless Browser Agent Image
# Uses Debian Bookworm for native container-compatible Chromium packages (avoids Ubuntu snapd stub).
FROM debian:bookworm-slim

# Prevent interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    git \
    curl \
    jq \
    ripgrep \
    python3 \
    ca-certificates \
    chromium \
    chromium-driver \
    fonts-liberation \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Enforce non-interactive execution invariants for LLM drivers
ENV TERM=dumb \
    PAGER=cat \
    GIT_PAGER=cat \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

CMD ["sh", "-c", "while true; do sleep 3600; done"]
